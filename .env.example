# Frontend
VITE_API_BIBLE_KEY=your-api-bible-key-here

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_OAUTH_KEY=your-google-oauth-client-id
GOOGLE_OAUTH_SECRET=your-google-oauth-client-secret
GEMINI_KEY=your-gemini-api-key

# PostgreSQL (private Docker network only)
POSTGRES_DB=bible_plan
POSTGRES_USER=bible_owner
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgres://bible_owner:replace-with-a-strong-database-password@bible-data:5432/bible_plan
APP_DATABASE_URL=postgres://bible_app_user:replace-with-a-strong-app-password@bible-data:5432/bible_plan
APP_DB_PASSWORD=replace-with-a-strong-app-password
PORT=3000
APP_VERSION=Alpha0.0.1
BUILD_HASH=local
