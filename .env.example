# Copy this file to .env.local (for local dev) and fill in real values.
# In Vercel: Project Settings -> Environment Variables -> add the same two keys.
#
# Both values come from Supabase Dashboard -> Project Settings -> API.
# Only the anon (publishable) key belongs here -- it carries no privileges by
# itself; every table is behind Row Level Security. NEVER put the
# service_role key in a VITE_ variable, since anything with the VITE_ prefix
# is bundled into the client-side JS and shipped to every visitor's browser.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
