# ============================================================================
# Bible Plan — environment variables
# ----------------------------------------------------------------------------
# Names only. Never commit real values: copy this file to `.env.local` (which
# is git-ignored) for local work, and set the same names in the Vercel
# dashboard under Settings -> Environment Variables for deployments.
#
# See docs/DEPLOYMENT.md for where each value comes from.
# ============================================================================

# ---- Required -------------------------------------------------------------
# Supabase project URL, e.g. https://<project-ref>.supabase.co
# Dashboard -> Project Settings -> Data API
SUPABASE_URL=

# Supabase anon / publishable key. Safe to expose to the browser: it carries
# no privileges of its own, and Row Level Security decides what each signed-in
# user may read or write. Served to the client by api/config.js.
# Dashboard -> Project Settings -> API Keys
SUPABASE_ANON_KEY=


# ---- Server-only. Do NOT add to the client, ever. --------------------------
# The service-role key bypasses Row Level Security completely. Nothing in this
# repository needs it today; it is listed only so nobody is tempted to put it
# in api/config.js or a <script> tag if a future server-side job needs one.
# If you ever set it, set it on the server environment alone.
# SUPABASE_SERVICE_ROLE_KEY=
